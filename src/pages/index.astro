---
import "../styles/global.css";
import Signature from "../components/Signature.astro";
import Translate from "../assets/icons/translate.svg";
import ExternalLink from "../assets/icons/external-link.svg";
import ChevronDown from "../assets/icons/chevron-down.svg";
import Globe from "../assets/icons/globe.svg";
import Code from "../assets/icons/code.svg";
import Email from "../assets/icons/email.svg";
import GitHub from "../assets/icons/github.svg";
import Briefcase from "../assets/icons/briefcase.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Homepage layout preview — caven.me</title>
  </head>
  <body>
    <div class="page-shell">
      <header>
        <p class="preview-note">Layout preview <span>02 / Quiet layout</span></p>
        <nav class="navigation block" aria-label="Navigation">
          <span class="eyebrow">01 / Navigation</span>
          <div class="nav-preview"><div class="nav-slots" aria-hidden="true"><span></span><span></span><span></span></div><span class="language-preview" aria-label="Language switch preview"><Translate class="pika-icon" aria-hidden="true" /> EN / 中</span></div>
        </nav>
      </header>

      <main>
        <section class="introduction block" aria-labelledby="introduction-title">
          <p class="eyebrow">02 / Profile</p>
          <div class="intro-layout">
            <div>
              <h1 id="introduction-title"><span class="hand-underlined">Introduction</span></h1>
              <div class="copy-lines" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="action-slots" aria-hidden="true"><span></span><span></span></div>
            </div>
            <div class="portrait-slot" aria-hidden="true">Portrait</div>
          </div>
        </section>

        <section class="selected-work block" aria-labelledby="work-title">
          <div class="section-heading"><h2 id="work-title"><span class="hand-underlined">Selected work</span></h2><span class="eyebrow">03 / Projects</span></div>
          <div class="project-grid">
            {[1, 2, 3].map((number) => (
              <article class="project-entry" aria-labelledby={`project-${number}-title`}>
                <div class="project-caption">
                  <h3 id={`project-${number}-title`}>Project {number}</h3>
                  <p class="project-description">Project introduction</p>
                  <div class="copy-lines" aria-hidden="true"><i></i><i></i><i></i></div>
                  <ul class="project-links" aria-label={`Project ${number} destination placeholders`}>
                    <li><Globe class="pika-icon" aria-hidden="true" /> Website <ExternalLink class="pika-icon external-link-icon" aria-hidden="true" /></li>
                    <li><Code class="pika-icon" aria-hidden="true" /> Source code <ExternalLink class="pika-icon external-link-icon" aria-hidden="true" /></li>
                  </ul>
                </div>
                <div class="project-visual" aria-hidden="true">{String(number).padStart(2, "0")}</div>
              </article>
            ))}
          </div>
        </section>

        <section class="experience block" aria-labelledby="experience-title">
          <div class="section-heading"><h2 id="experience-title"><span class="hand-underlined">Experience</span></h2><span class="eyebrow">04 / Timeline</span></div>
          <ol class="timeline" aria-label="Experience placeholders">
            {[1, 2, 3].map((number) => (
              <li>
                <div class="experience-heading">
                  <h3>Company {number}</h3>
                  <span class="experience-period">Location / Work mode</span>
                </div>
                <details class="experience-details" open={number === 1}>
                  <summary aria-label={`Role / Position — Company ${number}`}>
                    <span class="role-heading">
                      <span class="role-label"><Briefcase class="pika-icon" aria-hidden="true" /> Role / Position</span>
                      <ChevronDown class="pika-icon disclosure-icon" aria-hidden="true" />
                    </span>
                    <span class="experience-period">Employment type · Period · Duration</span>
                  </summary>
                  <ul class="contributions" aria-label={`Company ${number} contributions`}>
                    <li><span>Key contribution</span><span class="contribution-line" aria-hidden="true"></span></li>
                    <li><span>Key contribution</span><span class="contribution-line" aria-hidden="true"></span></li>
                  </ul>
                </details>
                <ul class="experience-tags" aria-label={`Company ${number} tags`}>
                  <li>Skill</li><li>Technology</li><li>Focus area</li>
                </ul>
              </li>
            ))}
          </ol>
        </section>

        <section class="tech-stack block" aria-labelledby="stack-title">
          <div class="section-heading">
            <h2 id="stack-title"><span class="hand-underlined">Tech stack</span></h2>
            <span class="eyebrow">05 / Toolkit</span>
          </div>
          <div class="stack-groups">
            {["Languages", "Frontend", "Engineering & Tools"].map((group) => (
              <div class="stack-group">
                <h3>{group}</h3>
                <ul class="stack-tags" aria-label={`${group} placeholders`}>
                  {[1, 2, 3, 4].map((number) => (
                    <li><span class="stack-icon" aria-hidden="true"></span>Technology {number}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section class="additional-work block" aria-labelledby="additional-title">
          <div class="section-heading"><h2 id="additional-title"><span class="hand-underlined">Additional work</span></h2><span class="eyebrow">06 / More</span></div>
          <div class="additional-slot"><span>Project slot</span><span class="detail-slot" aria-hidden="true"></span></div>
        </section>
      </main>

    </div>
    <footer class="footer" id="footer">
      <div class="footer-content">
        <div class="footer-farewell">
          <p class="eyebrow">07 / Until next time</p>
          <h2><span class="hand-underlined">Thanks for stopping by.</span></h2>
          <Signature />
        </div>
        <div class="footer-meta">
          <p>© 2026 Caven</p>
          <ul class="contact-placeholders" aria-label="Contact placeholders">
            <li><Email class="pika-icon" aria-hidden="true" /> Email <ExternalLink class="pika-icon external-link-icon" aria-hidden="true" /></li>
            <li><GitHub class="pika-icon" aria-hidden="true" /> GitHub <ExternalLink class="pika-icon external-link-icon" aria-hidden="true" /></li>
          </ul>
        </div>
      </div>
      <img
        class="footer-landscape"
        src="/images/tianchi-footer-study.png"
        width="2172"
        height="724"
        alt="Hand-drawn concept of Changbai Mountain's Tianchi crater lake"
        loading="lazy"
        decoding="async"
      />
    </footer>
  </body>
</html>
