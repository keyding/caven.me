---
import { home, contact, type Locale } from "../data/home";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale];
const site = Astro.site!;
const url = new URL(locale === "en" ? "/" : "/zh/", site);
const description = locale === "en"
  ? "Caven is a senior frontend engineer and frontend lead building web products, frontend architecture, PWA infrastructure, SDKs, and open source."
  : "丁强（Caven），高级前端工程师与前端技术负责人，专注 Web 产品、前端架构、复杂移动端交互、PWA 基础设施、SDK 工程与开源。";
const image = new URL("/images/og-caven.jpg", site);
const imageAlt = locale === "en"
  ? "Hello, I’m Caven. Senior Frontend Engineer & Frontend Lead, above a watercolor illustration of Tianchi."
  : "Caven 的个人网站分享卡片：高级前端工程师与前端技术负责人，配以天池水彩插画。";
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Caven",
  alternateName: "丁强",
  url: site.href,
  image: new URL("/images/caven-portrait.webp", site).href,
  jobTitle: t.role,
  sameAs: [contact.github, contact.x],
};
---
<title>{t.title}</title>
<meta name="description" content={description} />
<meta name="author" content="Caven" />
<meta name="application-name" content="Caven" />
<meta name="theme-color" content="#faf9f6" />
<meta name="color-scheme" content="light" />
<!-- Keep the placeholder site out of search until the release slice (#9). -->
<meta name="robots" content="noindex" />
<link rel="canonical" href={url} />
<link rel="alternate" hreflang="en" href={new URL("/", site)} />
<link rel="alternate" hreflang="zh-CN" href={new URL("/zh/", site)} />
<link rel="alternate" hreflang="x-default" href={new URL("/", site)} />
<link rel="icon" href="/favicon.ico?v=4" sizes="16x16 32x32 48x48" media="(prefers-color-scheme: light)" />
<!-- Separate URLs avoid reusing a rasterized light SVG after a theme change. -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" sizes="any" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/svg+xml" href="/favicon-dark.svg?v=4" sizes="any" media="(prefers-color-scheme: dark)" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Caven" />
<meta property="og:title" content={t.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={locale === "en" ? "en_US" : "zh_CN"} />
<meta property="og:locale:alternate" content={locale === "en" ? "zh_CN" : "en_US"} />
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@cavenasdev" />
<meta name="twitter:creator" content="@cavenasdev" />
<meta name="twitter:title" content={t.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(person).replaceAll("<", "\\u003c")} />
