---
import "../styles/global.css";
import Metadata from "./Metadata.astro";
import { home, contact, projectIds, homeTimeZone, type Locale } from "../data/home";
import Signature from "../components/Signature.astro";
import Translate from "../assets/icons/translate.svg";
import ExternalLink from "../assets/icons/external-link.svg";
import ChevronDown from "../assets/icons/chevron-down.svg";
import Globe from "../assets/icons/globe.svg";
import Code from "../assets/icons/code.svg";
import EmailReveal from "./EmailReveal.astro";
import LocalTime from "./LocalTime.astro";
import GitHub from "../assets/icons/github.svg";
import X from "../assets/icons/x.svg";
import VerificationCheck from "../assets/icons/verification-check.svg";
import Briefcase from "../assets/icons/briefcase.svg";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale];
const underlineClasses = "relative inline-block pb-2 after:absolute after:right-0 after:bottom-0 after:h-2 after:w-[58%] after:-rotate-2 after:rounded-[50%] after:border-t-4 after:border-highlight after:content-['']";
---

<!doctype html>
<html lang={t.lang} class="selection:bg-highlight selection:text-ink scheme-light scroll-pt-30 bg-paper font-sans text-ink [font-synthesis:none] max-sm:scroll-pt-40 [&_a]:text-inherit [&_a]:no-underline [&_a:focus-visible]:rounded-[3px] [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-solid [&_a:focus-visible]:outline-accent [&_a:focus-visible]:outline-offset-4 [&_a:hover]:text-accent [&_a:hover]:underline [&_a:hover]:underline-offset-4">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Metadata locale={locale} />
  </head>
  <body>
      <header class="sticky top-0 z-10 mx-auto w-[min(calc(100%-48px),768px)] bg-[#faf9f699] backdrop-blur-[20px] backdrop-saturate-140 max-sm:w-[calc(100%-32px)]">
        <nav class="flex h-22 items-center justify-between gap-5 px-8 max-sm:px-5 max-[380px]:gap-3" aria-label={t.navigation}>
          <a class="inline-flex min-h-11 shrink-0 items-center [&_.signature]:m-0 [&_.signature]:w-20" href={locale === "en" ? "/" : "/zh/"} aria-label="Caven"><Signature idPrefix="header" label={t.signature} /></a>
          <div class="m-0 flex list-none flex-wrap items-center justify-end gap-x-5 gap-y-2 p-0 text-[13px] max-sm:gap-x-3 [&_a]:inline-flex [&_a]:min-h-11 [&_a]:items-center [&_a]:gap-1.5">
            <a class="whitespace-nowrap" href={t.switchPath} hreflang={t.switchLang} lang={t.switchLang} aria-label={t.switchLabel} data-language-switch><Translate class="size-4.5 shrink-0" aria-hidden="true" />{t.switchText}</a>
          </div>
        </nav>
      </header>
    <div class="mx-auto w-[min(calc(100%-48px),768px)] pt-8 max-sm:w-[calc(100%-32px)] max-sm:pt-5">
      <main class="my-8 grid gap-8 max-sm:my-6 max-sm:gap-6">
        <section data-introduction class="px-8 py-10 max-sm:p-6" aria-labelledby="introduction-title">
          <div data-intro-stage="identity" class="mb-6 grid grid-cols-[120px_minmax(0,1fr)] items-center gap-7 max-sm:grid-cols-1 max-sm:gap-4">
            <div data-portrait class="relative size-30 overflow-hidden rounded-full border border-gray-200"><img class="h-auto w-full object-contain mask-[radial-gradient(at_50%_45%,black_52%,transparent_73%)]" src="/images/caven-portrait.webp" width="360" height="360" alt={t.portrait} /></div>
            <div>
              <h1 class="mb-4 max-sm:mb-2 font-display text-[clamp(36px,5vw,56px)] leading-[1.1] font-normal in-[:lang(zh-CN)]:leading-[1.4] max-sm:text-[32px]" id="introduction-title"><span class={underlineClasses}>{t.greeting}</span></h1>
              <p class="mb-0 flex items-center gap-1 text-base leading-[1.6] font-medium max-sm:text-[13px]"><span>{t.role}</span><VerificationCheck class="size-4.5 shrink-0 text-[#08b2c5]" aria-hidden="true" /></p>
            </div>
          </div>
            <div>
              <p data-intro-stage="details" class="text-[15px] leading-[1.8] text-[#616771]">{t.intro}</p>
              <div data-intro-contacts class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
              <div class="m-0 flex list-none flex-wrap items-center gap-x-5 gap-y-0 p-0 [&_a]:inline-flex [&_a]:min-h-8 [&_a]:items-center [&_a]:gap-1.5 text-sm leading-[inherit]">
                <EmailReveal href={contact.email} label={t.email} />
                <a href={contact.github} target="_blank" rel="noopener noreferrer"><GitHub class="size-4.5 shrink-0" aria-hidden="true" />GitHub</a>
                <a href={contact.x} target="_blank" rel="noopener noreferrer"><X class="size-4.5 shrink-0" aria-hidden="true" />X</a>
              </div>
                <LocalTime location={t.homeLocation} timeZone={homeTimeZone} zoneLabel={locale === "en" ? "UTC+8" : undefined} label={t.localTimeLabel} />
              </div>
            </div>
        </section>

        <section class="p-8 max-sm:p-6" aria-labelledby="work-title">
          <div class="mb-7 flex flex-wrap items-baseline justify-between gap-3 max-sm:mb-6"><h2 class="font-display text-[30px] leading-[1.2] font-normal in-[:lang(zh-CN)]:leading-[1.4] max-sm:text-[28px]" id="work-title"><span class={underlineClasses}>{t.work}</span></h2><span class="text-[11px] leading-normal tracking-[0.08em] uppercase text-[#535d6c]">{t.project}</span></div>
          <div class="grid grid-cols-1 gap-12 max-sm:gap-10">
            {[1, 2, 3].map((number) => (
              <article id={projectIds[number - 1]} class="min-w-0" aria-labelledby={`project-${number}-title`}>
                <div class="mb-6">
                  <h3 class="mb-4 text-xl leading-[inherit] font-medium" id={`project-${number}-title`}>{t.project} {number}</h3>
                  <p class="mb-3 text-sm leading-[inherit] text-[#616771]">{t.projectIntro}</p>
                  <div class="grid gap-2.5 [&_i]:block [&_i]:h-2 [&_i]:rounded-xs [&_i]:bg-[#a6b5c252] [&_i:last-child]:w-[65%]" aria-hidden="true"><i></i><i></i><i></i></div>
                  <ul class="mt-5 flex list-none flex-wrap gap-x-6 gap-y-3 p-0 text-sm leading-[inherit] text-[#616771] [&_li]:inline-flex [&_li]:items-center [&_li]:gap-1.5" aria-label={`${t.project} ${number} ${t.destinations}`}>
                    <li><Globe class="size-4.5 shrink-0" aria-hidden="true" /> {t.website} <ExternalLink class="size-3.5 shrink-0" aria-hidden="true" /></li>
                    <li><Code class="size-4.5 shrink-0" aria-hidden="true" /> {t.source} <ExternalLink class="size-3.5 shrink-0" aria-hidden="true" /></li>
                  </ul>
                </div>
                <div class="grid aspect-video place-items-center rounded-lg bg-[#e6e9e4] font-[Georgia,serif] text-4xl leading-[inherit] text-[#53664b]" aria-hidden="true">{String(number).padStart(2, "0")}</div>
              </article>
            ))}
          </div>
        </section>

        <section class="p-8 max-sm:p-6" aria-labelledby="experience-title">
          <div class="mb-7 flex flex-wrap items-baseline justify-between gap-3 max-sm:mb-6"><h2 class="font-display text-[30px] leading-[1.2] font-normal in-[:lang(zh-CN)]:leading-[1.4] max-sm:text-[28px]" id="experience-title"><span class={underlineClasses}>{t.experience}</span></h2><span class="text-[11px] leading-normal tracking-[0.08em] uppercase text-[#535d6c]">{t.timeline}</span></div>
          <ol class="m-0 list-none p-0 [&>li]:relative [&>li]:ml-1 [&>li]:border-l [&>li]:border-[#b7aa94] [&>li]:pb-8 [&>li]:pl-7 [&>li]:text-sm [&>li]:leading-[inherit] [&>li:last-child]:border-transparent [&>li:last-child]:pb-0 max-sm:[&>li]:pl-5 [&>li]:before:absolute [&>li]:before:-left-1.25 [&>li]:before:top-1.5 [&>li]:before:size-2.25 [&>li]:before:rounded-full [&>li]:before:border [&>li]:before:border-[#9e8e73] [&>li]:before:bg-paper [&>li]:before:content-['']" aria-label={t.experiencePlaceholders}>
            {[1, 2, 3].map((number) => (
              <li>
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 max-sm:flex-col max-sm:gap-1">
                  <h3 class="m-0 text-base leading-[inherit] font-medium">{t.company} {number}</h3>
                  <span class="text-xs leading-[inherit] text-[#686154]">{t.location}</span>
                </div>
                <details class="group mt-3" open={number === 1}>
                  <summary class="min-h-11 cursor-pointer list-none rounded py-2 hover:bg-[#292d3208] focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-4 [&::-webkit-details-marker]:hidden" aria-label={`${t.rolePlaceholder} — ${t.company} ${number}`}>
                    <span class="mb-1.5 flex items-center justify-between gap-4 font-medium">
                      <span class="inline-flex items-center gap-1.5"><Briefcase class="size-4.5 shrink-0" aria-hidden="true" /> {t.rolePlaceholder}</span>
                      <ChevronDown class="size-4 shrink-0 group-open:rotate-180" aria-hidden="true" />
                    </span>
                    <span class="text-xs leading-[inherit] text-[#686154]">{t.period}</span>
                  </summary>
                  <ul class="mt-4.5 grid list-disc gap-2.5 pl-4 text-xs leading-[inherit] text-[#686154] [&_li:last-child_span[aria-hidden]]:w-[60%]" aria-label={`${t.company} ${number} ${t.contributions}`}>
                    <li><span>{t.contribution}</span><span class="mt-2 block h-1.5 w-[85%] rounded-xs bg-[#b2a58e52]" aria-hidden="true"></span></li>
                    <li><span>{t.contribution}</span><span class="mt-2 block h-1.5 w-[85%] rounded-xs bg-[#b2a58e52]" aria-hidden="true"></span></li>
                  </ul>
                </details>
                <ul class="mt-4 flex list-none flex-wrap gap-2 p-0 [&_li]:rounded-[999px] [&_li]:border [&_li]:border-[#b7aa9466] [&_li]:bg-[#faf9f680] [&_li]:px-2.5 [&_li]:py-0.75 [&_li]:text-xs [&_li]:leading-[inherit] [&_li]:text-[#686154]" aria-label={`${t.company} ${number} ${t.tags}`}>
                  {t.skills.map((skill) => <li>{skill}</li>)}
                </ul>
              </li>
            ))}
          </ol>
        </section>

        <section class="p-8 max-sm:p-6" aria-labelledby="stack-title">
          <div class="mb-7 flex flex-wrap items-baseline justify-between gap-3 max-sm:mb-6">
            <h2 class="font-display text-[30px] leading-[1.2] font-normal in-[:lang(zh-CN)]:leading-[1.4] max-sm:text-[28px]" id="stack-title"><span class={underlineClasses}>{t.stack}</span></h2>
            <span class="text-[11px] leading-normal tracking-[0.08em] uppercase text-[#535d6c]">{t.toolkit}</span>
          </div>
          <div class="grid gap-6">
            {t.groups.map((group) => (
              <div>
                <h3 class="mb-3 text-sm leading-[inherit] font-medium">{group}</h3>
                <ul class="m-0 flex list-none flex-wrap gap-2 p-0 [&_li]:flex [&_li]:items-center [&_li]:gap-2 [&_li]:rounded-[999px] [&_li]:border [&_li]:border-[#292d3214] [&_li]:px-3 [&_li]:py-1.5 [&_li]:text-[13px] [&_li]:text-[#616771]" aria-label={`${group} ${t.placeholders}`}>
                  {[1, 2, 3, 4].map((number) => (
                    <li><span class="size-4 rounded-[3px] bg-[#c6d4df]" aria-hidden="true"></span>{t.technology} {number}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section class="p-8 max-sm:p-6" aria-labelledby="additional-title">
          <div class="mb-7 flex flex-wrap items-baseline justify-between gap-3 max-sm:mb-6"><h2 class="font-display text-[30px] leading-[1.2] font-normal in-[:lang(zh-CN)]:leading-[1.4] max-sm:text-[28px]" id="additional-title"><span class={underlineClasses}>{t.additional}</span></h2><span class="text-[11px] leading-normal tracking-[0.08em] uppercase text-[#535d6c]">{t.more}</span></div>
          <div class="flex items-center justify-between gap-6 rounded-md bg-[#eeede9] p-6 text-sm leading-[inherit] [&_span[aria-hidden]]:w-1/4 [&_span[aria-hidden]]:bg-[#c3c2be]"><span>{t.projectSlot}</span><span class="h-2 rounded-xs bg-[#b2a58e52]" aria-hidden="true"></span></div>
        </section>
      </main>

    </div>
    <footer class="pb-4" id="footer">
      <div class="mx-auto w-[min(calc(100%-48px),768px)] max-sm:w-[calc(100%-32px)]">
        <div class="px-8 pt-12 pb-9 max-sm:px-6 max-sm:pt-9 max-sm:pb-7">
          <p class="text-[11px] leading-normal tracking-[0.08em] uppercase text-[#535d6c]">{t.until}</p>
          <h2 class="mt-5 font-display text-[clamp(28px,4vw,36px)] leading-[1.2] font-normal in-[:lang(zh-CN)]:leading-[1.4]"><span class={underlineClasses}>{t.farewell}</span></h2>
          <Signature idPrefix="footer" label={t.signature} />
        </div>
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 border-t border-[#292d3214] px-8 py-6 text-xs leading-[inherit] text-[#616771] max-sm:px-6">
          <p>© 2026 Caven</p>
          <ul class="m-0 flex list-none flex-wrap items-center gap-x-5 gap-y-0 p-0 [&_a]:inline-flex [&_a]:min-h-8 [&_a]:items-center [&_a]:gap-1.5" aria-label={t.contact}>
            <li><EmailReveal href={contact.email} label={t.email} /></li>
            <li><a href={contact.github} target="_blank" rel="noopener noreferrer"><GitHub class="size-4.5 shrink-0" aria-hidden="true" />GitHub</a></li>
            <li><a href={contact.x} target="_blank" rel="noopener noreferrer"><X class="size-4.5 shrink-0" aria-hidden="true" />X</a></li>
          </ul>
        </div>
      </div>
      <img
        class="mx-auto my-0 h-auto w-full mix-blend-multiply"
        src="/images/tianchi-footer-study.png"
        width="2172"
        height="724"
        alt={t.landscape}
        loading="lazy"
        decoding="async"
      />
    </footer>
  </body>
</html>

<script>
  const languageLink = document.querySelector<HTMLAnchorElement>("[data-language-switch]");
  if (languageLink) {
    const destination = languageLink.pathname;
    const updateLanguageLink = () => {
      let id: string;
      try {
        id = decodeURIComponent(window.location.hash.slice(1));
      } catch {
        id = "";
      }
      languageLink.href = destination + (id && document.getElementById(id) ? window.location.hash : "");
    };
    updateLanguageLink();
    window.addEventListener("hashchange", updateLanguageLink);
  }
</script>
