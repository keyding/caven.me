---
import MapPin from "../assets/icons/map-pin.svg";
interface Props {
  location: string;
  timeZone: string;
  zoneLabel: string;
  label: string;
}
const { location, timeZone, zoneLabel, label } = Astro.props;
---

<p data-location-time class="m-0 ml-auto max-sm:ml-0 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] leading-[1.6] text-[#73716c]">
  <span class="flex items-center gap-1.5"><MapPin class="size-4.5 shrink-0" aria-hidden="true" />{location}</span>
  <span class="flex items-center gap-1.5 whitespace-nowrap tabular-nums" aria-label={label}>
    <time data-local-time data-time-zone={timeZone} hidden></time>
    <span>{zoneLabel}</span>
  </span>
</p>

<script>
  const clock = document.querySelector<HTMLTimeElement>("[data-local-time]");
  if (clock) {
    const formatter = new Intl.DateTimeFormat("en-GB", {
      timeZone: clock.dataset.timeZone,
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
    });
    const update = () => {
      const now = new Date();
      clock.dateTime = now.toISOString();
      clock.textContent = formatter.format(now);
      clock.hidden = false;
    };
    update();
    window.setInterval(update, 1000);
  }
</script>
