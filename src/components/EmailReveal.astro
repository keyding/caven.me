---
import Email from "../assets/icons/email.svg";
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<a data-email-reveal class="relative max-w-full before:absolute before:bottom-full before:left-0 before:h-1 before:w-full before:content-[''] after:pointer-events-auto after:absolute after:bottom-full after:left-0 after:rounded-lg after:mb-1 after:bg-[#292d30] after:px-2.5 after:py-1.5 after:text-xs after:leading-normal after:whitespace-nowrap after:text-paper after:content-[attr(data-tooltip)]" href={href} aria-label={label} data-tooltip={label === "邮件" ? "点击看看" : "Click to reveal"}>
  <Email class="size-4.5 shrink-0" aria-hidden="true" />
  <span class="min-w-0 wrap-anywhere" aria-hidden="true">{label}</span>
</a>

<style>
  /* Tooltip visibility and entrance motion stay together with their state selectors. */
  [data-email-reveal]::after {
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px) scale(.96);
    transform-origin: bottom left;
    transition: opacity 100ms ease, transform 100ms cubic-bezier(0.23, 1, 0.32, 1), visibility 0s linear 100ms;
  }
  @media (hover: hover) and (pointer: fine) {
    [data-email-reveal][role="button"]:not([data-tooltip-dismissed]):hover::after {
      opacity: 1; visibility: visible; transform: translateY(0) scale(1);
      transition: opacity 160ms ease 200ms, transform 160ms cubic-bezier(0.23, 1, 0.32, 1) 200ms, visibility 0s linear 200ms;
    }
  }
  [data-email-reveal][role="button"]:not([data-tooltip-dismissed]):focus-visible::after {
    opacity: 1; visibility: visible; transform: none; transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-email-reveal]::after,
    [data-email-reveal][role="button"]:not([data-tooltip-dismissed]):is(:hover, :focus-visible)::after {
      transition: none; transform: none;
    }
  }
</style>

<script>
  const storageKey = "caven.email-revealed.v1";
  let savedAddress: string | null = null;
  try { savedAddress = localStorage.getItem(storageKey); } catch { /* Storage may be disabled. */ }
  const controls: { link: HTMLAnchorElement; address: string; finish: () => void }[] = [];
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-email-reveal]")) {
    const text = link.querySelector("span");
    if (!text) continue;
    const address = link.getAttribute("href")!.slice(7);
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const characters = "abcdefghijklmnopqrstuvwxyz0123456789@#$%";
    let state: "idle" | "animating" | "revealed" = "idle";
    let frame = 0;
    link.setAttribute("role", "button");
    link.setAttribute("aria-description", link.dataset.tooltip!);
    link.addEventListener("pointerleave", () => {
      if (!link.matches(":focus-visible")) delete link.dataset.tooltipDismissed;
    });
    link.addEventListener("blur", () => { delete link.dataset.tooltipDismissed; });
    const finish = () => {
      cancelAnimationFrame(frame);
      link.dataset.emailExpanded = "";
      text.textContent = address;
      link.setAttribute("aria-label", address);
      link.removeAttribute("role");
      link.removeAttribute("aria-description");
      state = "revealed";
    };
    controls.push({ link, address, finish });
    if (savedAddress === address) finish();
    link.addEventListener("click", (event) => {
      if (state === "revealed") return;
      event.preventDefault();
      if (state === "animating") { finish(); return; }
      state = "animating";
      link.dataset.emailExpanded = "";
      try { localStorage.setItem(storageKey, address); } catch { /* In-page sync still works. */ }
      for (const other of controls) {
        if (other.link !== link && other.address === address) other.finish();
      }
      link.dataset.tooltipDismissed = "";
      if (motion.matches || event.detail === 0) { finish(); return; }
      const start = performance.now();
      let lastStep = -1;
      const animate = (now: number) => {
        const step = Math.floor((now - start) / 40);
        if (step >= address.length) { finish(); return; }
        if (step !== lastStep) {
          text.textContent = [...address].map((character, index) => index < step ? character : characters[Math.floor(Math.random() * characters.length)]).join("");
          lastStep = step;
        }
        frame = requestAnimationFrame(animate);
      };
      frame = requestAnimationFrame(animate);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") link.dataset.tooltipDismissed = "";
    });
    link.addEventListener("keydown", (event) => {
      if (event.key === " " && state !== "revealed") {
        event.preventDefault();
        link.click();
      }
    });
    motion.addEventListener("change", () => {
      if (motion.matches && state === "animating") finish();
    });
    window.addEventListener("pagehide", () => {
      if (state === "animating") finish();
    });
  }
</script>
