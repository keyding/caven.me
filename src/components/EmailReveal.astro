---
import Email from "../assets/icons/email.svg";
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<a class="email-reveal" href={href} aria-label={label}>
  <Email class="pika-icon" aria-hidden="true" />
  <span aria-hidden="true">{label}</span>
</a>

<style>
  .email-reveal { max-width: 100%; }
  .email-reveal span { overflow-wrap: anywhere; min-width: 0; }
  .email-reveal svg { flex-shrink: 0; }
</style>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>(".email-reveal")) {
    const text = link.querySelector("span");
    if (!text) continue;
    const address = link.getAttribute("href")!.slice(7);
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const characters = "abcdefghijklmnopqrstuvwxyz0123456789@#$%";
    let state: "idle" | "animating" | "revealed" = "idle";
    let frame = 0;
    link.setAttribute("role", "button");
    const finish = () => {
      cancelAnimationFrame(frame);
      text.textContent = address;
      link.setAttribute("aria-label", address);
      link.removeAttribute("role");
      state = "revealed";
    };
    link.addEventListener("click", (event) => {
      if (state === "revealed") return;
      event.preventDefault();
      if (state === "animating") return;
      state = "animating";
      if (motion.matches) { finish(); return; }
      const start = performance.now();
      let lastStep = -1;
      const animate = (now: number) => {
        const step = Math.floor((now - start) / 40);
        if (step >= address.length) { finish(); return; }
        if (step !== lastStep) {
          text.textContent = [...address].map((character, index) => index < step ? character : characters[Math.floor(Math.random() * characters.length)]).join("");
          lastStep = step;
        }
        frame = requestAnimationFrame(animate);
      };
      frame = requestAnimationFrame(animate);
    });
    link.addEventListener("keydown", (event) => {
      if (event.key === " " && state !== "revealed") {
        event.preventDefault();
        link.click();
      }
    });
    motion.addEventListener("change", () => {
      if (motion.matches && state === "animating") finish();
    });
    window.addEventListener("pagehide", () => {
      if (state === "animating") finish();
    });
  }
</script>
